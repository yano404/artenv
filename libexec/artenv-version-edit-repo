#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${script_dir}/util.sh"

usage() {
  cat <<'EOS'
usage: artenv version edit-repo <name>

Open an image repository's config (image-repos/<name>.toml) in $EDITOR.
After editing, the file is checked for valid TOML syntax and for a valid
ghcr.io image path.

Options:
  -h, --help    Show this help
EOS
}

main() {
  [[ -n "${ARTENV_ROOT:-}" ]] || die "ARTENV_ROOT is not set"
  ensure_default_image_repo
  require_yq

  local name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      -*)        die "unknown option: $1" ;;
      *)
        [[ -z "${name}" ]] || die "usage: artenv version edit-repo <name>"
        name="$1"; shift ;;
    esac
  done

  [[ -n "${name}" ]] || die "usage: artenv version edit-repo <name>"
  validate_image_repo_name "${name}"

  local conf
  conf="$(image_repo_conf "${name}")"
  [[ -f "${conf}" ]] || die "no such image repository: ${name} (see \`artenv version repos')"

  local editor="${VISUAL:-${EDITOR:-vi}}"
  # shellcheck disable=SC2086  # editor may carry arguments (e.g. `code -w`)
  ${editor} "${conf}"

  if ! yq -p toml -oy '.' "${conf}" >/dev/null 2>&1; then
    printf 'artenv: warning: %s is not valid TOML after editing\n' "${conf}" >&2
    exit 1
  fi

  local image
  image="$(toml_get "${conf}" repo image "")"
  validate_ghcr_image "${image}"
}

main "$@"
