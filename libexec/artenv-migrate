#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${script_dir}/util.sh"

read_git_repos_v1() {
  local path="$1"

  if [[ -f "${path}" && ! -L "${path}" ]]; then
    tr -d '\n' < "${path}"
    return 0
  fi

  if [[ -L "${path}" ]]; then
    readlink -- "${path}"
    return 0
  fi

  return 1
}

# migrate_* keep a v1 entry whose links cannot be resolved and count it in
# MIGRATE_FAILED; an original is removed only after its TOML has been written.
MIGRATE_FAILED=0

# Resolve <path> into the variable named <var>; fail on a missing target.
migrate_resolve() { # <var> <path>
  local _resolved
  _resolved="$(resolve_path "$2")" || return 1
  [[ -n "${_resolved}" ]] || return 1
  printf -v "$1" '%s' "${_resolved}"
}

migrate_fail() { # <kind> <name> <path>
  printf "artenv: cannot migrate %s '%s': cannot resolve %s (kept as is)\n" "$1" "$2" "$3" >&2
  MIGRATE_FAILED=$((MIGRATE_FAILED + 1))
}

migrate_versions() {
  local versions_dir="${ARTENV_ROOT}/versions"

  shopt -s nullglob
  local -a version_dirs=("${versions_dir}"/*)
  shopt -u nullglob

  local entry version_name version_type conf
  for entry in "${version_dirs[@]}"; do
    [[ -d "${entry}" ]] || continue
    version_name="$(basename "${entry}")"
    conf="${versions_dir}/${version_name}.toml"

    if [[ -f "${conf}" ]]; then
      printf '  skip (already migrated): %s\n' "${version_name}"
      continue
    fi

    version_type="native"
    if [[ -f "${entry}/type" ]]; then
      version_type="$(< "${entry}/type")"
    fi

    local tmp
    if [[ "${version_type}" == "apptainer" ]]; then
      local image=""
      if ! migrate_resolve image "${entry}/image"; then
        migrate_fail "version" "${version_name}" "${entry}/image"
        continue
      fi
      tmp="$(mktemp "${versions_dir}/.tmp.migrate.XXXXXX")"
      {
        printf '[version]\n'
        printf 'type = "apptainer"\n'
        printf 'image = "%s"\n' "${image}"
      } > "${tmp}"
    else
      local artsys="" rootsys="" yamllib="" yamlcmake="" key bad=""
      for key in artsys rootsys yamllib yamlcmake; do
        migrate_resolve "${key}" "${entry}/${key}" || { bad="${entry}/${key}"; break; }
      done
      if [[ -n "${bad}" ]]; then
        migrate_fail "version" "${version_name}" "${bad}"
        continue
      fi
      tmp="$(mktemp "${versions_dir}/.tmp.migrate.XXXXXX")"
      {
        printf '[version]\n'
        printf 'type = "native"\n'
        printf 'artsys = "%s"\n'    "${artsys}"
        printf 'rootsys = "%s"\n'   "${rootsys}"
        printf 'yamllib = "%s"\n'   "${yamllib}"
        printf 'yamlcmake = "%s"\n' "${yamlcmake}"
      } > "${tmp}"
    fi

    mv -- "${tmp}" "${conf}"
    rm -rf -- "${entry}"
    printf '  migrated version: %s\n' "${version_name}"
  done
}

migrate_envs() {
  local envs_dir="${ARTENV_ROOT}/envs"

  shopt -s nullglob
  local -a env_dirs=("${envs_dir}"/*)
  shopt -u nullglob

  local entry env_name conf
  for entry in "${env_dirs[@]}"; do
    [[ -d "${entry}" ]] || continue
    env_name="$(basename "${entry}")"
    conf="${envs_dir}/${env_name}.toml"

    if [[ -f "${conf}" ]]; then
      printf '  skip (already migrated): %s\n' "${env_name}"
      continue
    fi

    local version_dir="" version_name
    if ! migrate_resolve version_dir "${entry}/version"; then
      migrate_fail "env" "${env_name}" "${entry}/version"
      continue
    fi
    version_name="$(basename "${version_dir}")"

    local work_dir=""
    if ! migrate_resolve work_dir "${entry}/work"; then
      migrate_fail "env" "${env_name}" "${entry}/work"
      continue
    fi

    local git_repos=""
    if [[ -e "${entry}/git_repos" ]]; then
      git_repos="$(read_git_repos_v1 "${entry}/git_repos" || true)"
    fi

    local use_artlogin="false"
    if [[ -f "${entry}/artlogin.sh" ]]; then
      use_artlogin="true"
      cp -- "${entry}/artlogin.sh" "${envs_dir}/${env_name}.artlogin.sh"
    fi

    local tmp
    tmp="$(mktemp "${envs_dir}/.tmp.migrate.XXXXXX")"
    {
      printf '[env]\n'
      printf 'version = "%s"\n' "${version_name}"
      printf 'work = "%s"\n'    "${work_dir}"
      if [[ -n "${git_repos}" ]]; then
        printf 'git_repos = "%s"\n' "${git_repos}"
      fi
      printf 'use_artlogin = %s\n' "${use_artlogin}"
    } > "${tmp}"

    mv -- "${tmp}" "${conf}"
    rm -rf -- "${entry}"
    printf '  migrated env: %s\n' "${env_name}"
  done
}

migrate_default() {
  local target="${ARTENV_ROOT}/env"

  if [[ -L "${target}" ]]; then
    local env_dir env_name
    env_dir="$(readlink -- "${target}")"
    env_name="$(basename "${env_dir}")"
    rm -- "${target}"
    printf '%s\n' "${env_name}" > "${target}"
    printf '  migrated default env: %s\n' "${env_name}"
  elif [[ -f "${target}" ]]; then
    printf '  skip (already migrated): default env\n'
  fi
}

usage() {
  cat <<'EOS'
usage: artenv migrate

Migrate v1 (symlink-based) data to v2 (TOML-based).

Options:
  -h, --help    Show this help
EOS
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      *)         die "usage: artenv migrate" ;;
    esac
  done

  [[ -n "${ARTENV_ROOT:-}" ]] || die "ARTENV_ROOT is not set"

  printf 'Migrating artenv v1 -> v2 ...\n'

  printf '\n[versions]\n'
  migrate_versions

  printf '\n[envs]\n'
  migrate_envs

  printf '\n[default]\n'
  migrate_default

  if [[ "${MIGRATE_FAILED}" -gt 0 ]]; then
    printf '\n'
    die "some entries could not be migrated (${MIGRATE_FAILED}); fix the links above and re-run \`artenv migrate'"
  fi
  printf '\nDone.\n'
}

main "$@"
